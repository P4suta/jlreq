; The unit tests, run by `dune runtest`.
;
; No test framework: the engine depends on `ocaml` and `dune` and nothing else,
; and a test suite that needs an opam package would make that claim false for
; anybody trying to reproduce a result. `check.ml` is thirty lines of `assert`
; with a counter, which is all these tests want.
;
; The English transcriptions of Appendices B through E are embedded here and
; nowhere else. The engine reads the Japanese ones (see `lib/specdata/dune`); this
; rule gives the tests the other transcription so that `test_tables.ml` can compare
; them cell for cell. The Rust engine reads the English side, so agreement here is
; the third independent reading of the same six PDF pages -- and a disagreement is
; a transcription defect that would otherwise show up as an unexplained DIFF nine
; milestones from now.

(rule
 (targets en_data.ml)
 (deps
  %{project_root}/spec/captured/table1.en.tsv
  %{project_root}/spec/captured/table2.en.tsv
  %{project_root}/spec/captured/table3.en.tsv
  %{project_root}/spec/captured/table4.en.tsv
  %{project_root}/spec/captured/table5.en.tsv
  %{project_root}/spec/captured/table6.en.tsv)
 (action
  (with-stdout-to
   en_data.ml
   (progn
    (echo
     "(* SPDX-FileCopyrightText: 2026 jlreq contributors *)\n(* SPDX-License-Identifier: MIT OR Apache-2.0 *)\n\n(* Generated by engines/ocaml/test/dune. Do not edit, do not commit. *)\n\nlet table1 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table1.en.tsv)
    (echo "|jlreqtsv}\n\nlet table2 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table2.en.tsv)
    (echo "|jlreqtsv}\n\nlet table3 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table3.en.tsv)
    (echo "|jlreqtsv}\n\nlet table4 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table4.en.tsv)
    (echo "|jlreqtsv}\n\nlet table5 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table5.en.tsv)
    (echo "|jlreqtsv}\n\nlet table6 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table6.en.tsv)
    (echo "|jlreqtsv}\n")))))

(test
 (name test_jlreq)
 (libraries jlreq jlreq_proto)
 (flags
  (:standard -w +a-4-40-41-42-44-45-70 -strict-sequence -strict-formats -safe-string)))
