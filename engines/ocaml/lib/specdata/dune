; Layer 0 of the engine: the specification tables, as strings.
;
; The runner starts an engine with `Command::new(path)` and no arguments, from a
; working directory it never tells the engine about, so the tables cannot be read
; from disk at run time. They are pasted into a generated module instead, each
; file as one OCaml quoted string literal `{jlreqtsv|...|jlreqtsv}`, which needs no
; escaping and therefore no helper program: `cat` is the whole encoder.
;
; The captured Appendix B-E matrices are read in *Japanese*. The Rust engine reads
; the English ones. Two engines built on two independent transcriptions of the same
; PDF pages is the point of a second implementation; `engines/ocaml/test` compares
; the two transcriptions and makes the agreement a test rather than an assumption.

(rule
 (targets spec_data.ml)
 (deps
  %{project_root}/spec/derived/appendix-a.tsv
  %{project_root}/spec/derived/folding.tsv
  %{project_root}/spec/derived/ideographs.tsv
  %{project_root}/spec/derived/scripts.tsv
  %{project_root}/spec/derived/classes.tsv
  %{project_root}/spec/derived/questions.tsv
  %{project_root}/spec/captured/table1.ja.tsv
  %{project_root}/spec/captured/table2.ja.tsv
  %{project_root}/spec/captured/table3.ja.tsv
  %{project_root}/spec/captured/table4.ja.tsv
  %{project_root}/spec/captured/table5.ja.tsv
  %{project_root}/spec/captured/table6.ja.tsv)
 (action
  (with-stdout-to
   spec_data.ml
   (progn
    (echo
     "(* SPDX-FileCopyrightText: 2026 jlreq contributors *)\n(* SPDX-License-Identifier: MIT OR Apache-2.0 *)\n\n(* Generated by engines/ocaml/lib/specdata/dune. Do not edit, do not commit. *)\n\nlet appendix_a = {jlreqtsv|")
    (cat %{project_root}/spec/derived/appendix-a.tsv)
    (echo "|jlreqtsv}\n\nlet folding = {jlreqtsv|")
    (cat %{project_root}/spec/derived/folding.tsv)
    (echo "|jlreqtsv}\n\nlet ideographs = {jlreqtsv|")
    (cat %{project_root}/spec/derived/ideographs.tsv)
    (echo "|jlreqtsv}\n\nlet scripts = {jlreqtsv|")
    (cat %{project_root}/spec/derived/scripts.tsv)
    (echo "|jlreqtsv}\n\nlet classes = {jlreqtsv|")
    (cat %{project_root}/spec/derived/classes.tsv)
    (echo "|jlreqtsv}\n\nlet questions = {jlreqtsv|")
    (cat %{project_root}/spec/derived/questions.tsv)
    (echo "|jlreqtsv}\n\nlet table1 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table1.ja.tsv)
    (echo "|jlreqtsv}\n\nlet table2 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table2.ja.tsv)
    (echo "|jlreqtsv}\n\nlet table3 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table3.ja.tsv)
    (echo "|jlreqtsv}\n\nlet table4 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table4.ja.tsv)
    (echo "|jlreqtsv}\n\nlet table5 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table5.ja.tsv)
    (echo "|jlreqtsv}\n\nlet table6 = {jlreqtsv|")
    (cat %{project_root}/spec/captured/table6.ja.tsv)
    (echo "|jlreqtsv}\n")))))

(library
 (name jlreq_specdata)
 (modules spec_data))
